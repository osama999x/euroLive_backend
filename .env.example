# Application
NODE_ENV=development
PORT=3000
APP_NAME=King Queen Live
API_PREFIX=api/v1
API_VERSION=1.0.0

# PostgreSQL
# Local docker-compose: kql / kql_secret / king_queen_live
# Remote empty DB: postgres / <secret> / eurolive  (keep secrets in .env only)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kql
DB_PASSWORD=kql_secret
DB_DATABASE=king_queen_live
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_KEY_PREFIX=kql:

# JWT — change these before production
JWT_SECRET=change-me-access-secret-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-32
JWT_REFRESH_EXPIRES_IN=7d

# Seeded Super Admin (created on first boot if missing)
SEED_ADMIN_EMAIL=admin@kinglive.local
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@Admin1

# Mail (optional — skipped when MAIL_HOST is empty)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="King Queen Live <noreply@localhost>"

# HTTP
CORS_ORIGIN=*
BODY_LIMIT=10mb
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Swagger (disabled automatically in production)
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123
